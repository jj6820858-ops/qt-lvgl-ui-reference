# Script mode: cmake -DAT_SOURCE_DIR=... -DAT_OUTPUT_FILE=... -P this
#
# Walks ui/ and writes a markdown index of every QML type, grouped by module.
# Keeps docs/generated/QmlCatalog.md honest without anyone maintaining it.
if(NOT ST_SOURCE_DIR OR NOT ST_OUTPUT_FILE)
    message(FATAL_ERROR "ST_SOURCE_DIR and ST_OUTPUT_FILE are required")
endif()

set(_out "# QML component catalog\n\n")
string(APPEND _out "Generated by `cmake --build <dir> --target st_qml_catalog`. Do not edit.\n\n")

file(GLOB _modules RELATIVE "${ST_SOURCE_DIR}/ui" "${ST_SOURCE_DIR}/ui/*")
list(SORT _modules)

foreach(_mod IN LISTS _modules)
    if(NOT IS_DIRECTORY "${ST_SOURCE_DIR}/ui/${_mod}")
        continue()
    endif()

    file(GLOB _qml RELATIVE "${ST_SOURCE_DIR}/ui/${_mod}" "${ST_SOURCE_DIR}/ui/${_mod}/*.qml")
    if(NOT _qml)
        continue()
    endif()

    string(APPEND _out "## SmarTon.Ui.${_mod}\n\n")
    list(SORT _qml)
    foreach(_f IN LISTS _qml)
        get_filename_component(_type "${_f}" NAME_WE)
        file(READ "${ST_SOURCE_DIR}/ui/${_mod}/${_f}" _content)
        set(_brief "")
        if(_content MATCHES "\\\\brief ([^\n]+)")
            set(_brief "${CMAKE_MATCH_1}")
        endif()
        string(APPEND _out "- **${_type}** — ${_brief}\n")
    endforeach()
    string(APPEND _out "\n")
endforeach()

file(WRITE "${ST_OUTPUT_FILE}" "${_out}")
message(STATUS "Wrote ${ST_OUTPUT_FILE}")
