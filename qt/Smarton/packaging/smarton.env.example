# Copy to /etc/smarton/smarton.env on the panel, set owner root:root and mode
# 0600. This file is intentionally not committed with real credentials.
#
# Enable MQTT by setting SMARTON_MQTT_URL. Do not put user/password in the
# URL: command line arguments can be read by other local processes.
# SMARTON_MQTT_URL=mqtt://192.168.1.20:1883
# SMARTON_MQTT_USERNAME=smarton-panel
# SMARTON_MQTT_PASSWORD=replace-with-a-long-unique-secret
#
# Optional topic templates. %1 is the SmarTon device id.
# SMARTON_MQTT_STATE_TOPIC=zigbee2mqtt/%1
# SMARTON_MQTT_COMMAND_TOPIC=zigbee2mqtt/%1/set
# SMARTON_MQTT_ON_PAYLOAD=ON
# SMARTON_MQTT_OFF_PAYLOAD=OFF
