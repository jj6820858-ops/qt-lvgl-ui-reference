# Doxygen configuration for the C++ layers.
# QML types are documented with qdoc comments in the .qml files themselves.

PROJECT_NAME           = "SmarTon"
PROJECT_BRIEF          = "Layered Qt 6 / QML reference application"
PROJECT_NUMBER         = 0.1.0

INPUT                  = ../common ../core ../domain ../services \
                         ../infrastructure ../models ../backend
FILE_PATTERNS          = *.h *.cpp
RECURSIVE              = YES
OUTPUT_DIRECTORY       = .

# Undocumented code should LOOK undocumented.
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_NO_PARAMDOC       = YES

JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = YES
BUILTIN_STL_SUPPORT    = YES

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES
GENERATE_LATEX         = NO

HAVE_DOT               = YES
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
INCLUDE_GRAPH          = NO
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES

SOURCE_BROWSER         = YES
REFERENCED_BY_RELATION = YES
